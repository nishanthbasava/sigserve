# Web image: build the SPA with node, serve it with nginx. nginx also
# proxies /api/* to the api service, so the stack works the same with or
# without Caddy in front (dev compose publishes this container directly;
# prod puts Caddy ahead of it for TLS).
FROM node:20-slim AS build

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build

FROM nginx:alpine
COPY web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
