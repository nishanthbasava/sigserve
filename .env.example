POSTGRES_USER=sigserve
POSTGRES_PASSWORD=sigserve
POSTGRES_DB=sigserve
DATABASE_URL=postgresql+psycopg://sigserve:sigserve@postgres:5432/sigserve
REDIS_URL=redis://redis:6379/0
# Public hostname for Caddy's TLS certificate (prod). Compose reads this
# file for interpolation, so setting it here survives reboots and new
# shells -- no export needed.
SIGSERVE_DOMAIN=localhost
